{
  "id": null,
  "uid": "overview",
  "title": "Portfolio Monitoring",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "1m",
  "tags": [
    "portfolio",
    "monitoring"
  ],
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Minutes Since Last Price Update",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "portfolio-postgres"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "format": "table",
          "refId": "A",
          "rawSql": "SELECT 'minutes_since_last_price' AS metric, EXTRACT(EPOCH FROM (NOW() - MAX(as_of_utc))) / 60 AS value FROM prices;",
          "rawQuery": true
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 15
              },
              {
                "color": "red",
                "value": 60
              }
            ]
          },
          "unit": "m"
        },
        "overrides": []
      },
      "pluginVersion": "9.5.0"
    },
    {
      "id": 2,
      "title": "Stale Instruments (Top 10)",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "portfolio-postgres"
      },
      "gridPos": {
        "h": 6,
        "w": 16,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "format": "table",
          "refId": "A",
          "rawSql": "SELECT i.symbol, MAX(p.as_of_utc) AS last_price_utc, ROUND(EXTRACT(EPOCH FROM (NOW() - MAX(p.as_of_utc))) / 60, 2) AS minutes_stale FROM prices p JOIN instruments i ON i.instrument_id = p.instrument_id GROUP BY i.symbol ORDER BY last_price_utc ASC LIMIT 10;",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "center"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 30
              },
              {
                "color": "red",
                "value": 60
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      },
      "pluginVersion": "9.5.0"
    },
    {
      "id": 3,
      "title": "Prices Ingested per Day",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "portfolio-postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "format": "time_series",
          "refId": "A",
          "rawSql": "SELECT $__timeGroup(created_at::timestamp, '1d') AS time, COUNT(*) AS prices_ingested FROM prices GROUP BY 1 ORDER BY 1;",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "sum"
          ],
          "displayMode": "list",
          "placement": "right"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "pluginVersion": "9.5.0"
    },
    {
      "id": 4,
      "title": "Latest Snapshot per Account",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "portfolio-postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "format": "table",
          "refId": "A",
          "rawSql": "SELECT account_id, MAX(snapshot_at) AS latest_snapshot_at, ROUND(EXTRACT(EPOCH FROM (NOW() - MAX(snapshot_at))) / 3600, 2) AS hours_since_snapshot FROM portfolio_value_snapshot GROUP BY account_id ORDER BY latest_snapshot_at DESC;",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "center"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "unit": "h",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      },
      "pluginVersion": "9.5.0"
    },
    {
      "id": 5,
      "title": "Accounts Missing Today",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "portfolio-postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "targets": [
        {
          "format": "table",
          "refId": "A",
          "rawSql": "SELECT 'accounts_stale' AS metric, COUNT(*)::double precision AS value FROM (SELECT account_id, MAX(snapshot_at) AS last_snapshot FROM portfolio_value_snapshot GROUP BY account_id) t WHERE last_snapshot < NOW() - INTERVAL '2 hours';",
          "rawQuery": true
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "pluginVersion": "9.5.0"
    },
    {
      "id": 7,
      "title": "Current Positions",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "portfolio-postgres"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "format": "table",
          "refId": "A",
          "rawSql": "WITH latest_positions AS (SELECT * FROM positions_snapshot WHERE snapshot_at = (SELECT MAX(snapshot_at) FROM positions_snapshot)) SELECT lp.account_id, inst.symbol, lp.shares, lp.cost_basis_eur, pr.close AS last_price, (lp.shares * pr.close) AS market_value, (lp.shares * pr.close) - lp.cost_basis_eur AS pnl_eur FROM latest_positions lp JOIN instruments inst ON inst.instrument_id = lp.instrument_id LEFT JOIN LATERAL (SELECT close FROM prices p WHERE p.instrument_id = lp.instrument_id ORDER BY as_of_utc DESC LIMIT 1) pr ON true ORDER BY market_value DESC;",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "center"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      },
      "pluginVersion": "9.5.0"
    },
    {
      "id": 6,
      "title": "Snapshots Recorded per Day",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "portfolio-postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "targets": [
        {
          "format": "time_series",
          "refId": "A",
          "rawSql": "SELECT $__timeGroup(snapshot_at::timestamp, '1h') AS time, COUNT(*) AS snapshots FROM portfolio_value_snapshot GROUP BY 1 ORDER BY 1;",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "count"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "sum"
          ],
          "displayMode": "list",
          "placement": "right"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "pluginVersion": "9.5.0"
    },
    {
      "id": 8,
      "title": "Portfolio Value (EUR)",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "portfolio-postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 43
      },
      "targets": [
        {
          "format": "time_series",
          "refId": "A",
          "rawSql": "SELECT $__timeGroup(snapshot_at::timestamp, '1h') AS time, SUM(value_eur) AS portfolio_value_eur FROM portfolio_value_snapshot GROUP BY 1 ORDER BY 1;",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "currencyEUR"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "max",
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "right"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "pluginVersion": "9.5.0"
    }
  ],
  "templating": {
    "list": []
  }
}