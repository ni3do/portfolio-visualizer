    {
      "id": 5,
      "title": "Rows by Table",
      "type": "barchart",
      "datasource": {
        "type": "postgres",
        "uid": "portfolio-postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH table_counts AS (\n    SELECT 'instruments' AS table_name, COUNT(*)::double precision AS row_count FROM instruments\n    UNION ALL\n    SELECT 'transactions' AS table_name, COUNT(*)::double precision AS row_count FROM transactions\n    UNION ALL\n    SELECT 'cash_movements' AS table_name, COUNT(*)::double precision AS row_count FROM cash_movements\n    UNION ALL\n    SELECT 'prices' AS table_name, COUNT(*)::double precision AS row_count FROM prices\n    UNION ALL\n    SELECT 'fx_rates' AS table_name, COUNT(*)::double precision AS row_count FROM fx_rates\n    UNION ALL\n    SELECT 'positions_snapshot' AS table_name, COUNT(*)::double precision AS row_count FROM positions_snapshot\n    UNION ALL\n    SELECT 'portfolio_value_snapshot' AS table_name, COUNT(*)::double precision AS row_count FROM portfolio_value_snapshot\n)\nSELECT table_name AS label, row_count AS value\nFROM table_counts\nORDER BY row_count DESC;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "mappings": [],
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "legend": {
          "displayMode": "table",
          "placement": "right"
        },
        "orientation": "horizontal",
        "tooltip": {
          "mode": "single"
        }
      },
      "pluginVersion": "9.5.0"
    },
    {
      "id": 6,
      "title": "Latest Data Timestamp",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "portfolio-postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH table_meta AS (\n    SELECT 'instruments' AS table_name,\n           COUNT(*)::bigint AS row_count,\n           MAX(created_at) AS last_timestamp\n    FROM instruments\n    UNION ALL\n    SELECT 'transactions' AS table_name,\n           COUNT(*)::bigint AS row_count,\n           MAX(date_time_utc) AS last_timestamp\n    FROM transactions\n    UNION ALL\n    SELECT 'cash_movements' AS table_name,\n           COUNT(*)::bigint AS row_count,\n           MAX(date_time_utc) AS last_timestamp\n    FROM cash_movements\n    UNION ALL\n    SELECT 'prices' AS table_name,\n           COUNT(*)::bigint AS row_count,\n           MAX(as_of_utc) AS last_timestamp\n    FROM prices\n    UNION ALL\n    SELECT 'fx_rates' AS table_name,\n           COUNT(*)::bigint AS row_count,\n           MAX(date_utc)::timestamp AT TIME ZONE 'UTC' AS last_timestamp\n    FROM fx_rates\n    UNION ALL\n    SELECT 'positions_snapshot' AS table_name,\n           COUNT(*)::bigint AS row_count,\n           MAX(snapshot_at) AS last_timestamp\n    FROM positions_snapshot\n    UNION ALL\n    SELECT 'portfolio_value_snapshot' AS table_name,\n           COUNT(*)::bigint AS row_count,\n           MAX(snapshot_at) AS last_timestamp\n    FROM portfolio_value_snapshot\n)\nSELECT table_name,\n       row_count::double precision AS row_count,\n       last_timestamp\nFROM table_meta\nORDER BY table_name;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "custom": {
            "align": "center"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "row_count"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "last_timestamp"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTime"
              },
              {
                "id": "custom.align",
                "value": "left"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      },
      "pluginVersion": "9.5.0"
    },
    {
      "id": 7,
      "title": "Daily Rows Added",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "portfolio-postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH combined AS (\n    SELECT date_trunc('day', created_at) AS bucket, 'instruments' AS table_name, COUNT(*)::bigint AS row_count\n    FROM instruments\n    WHERE $__timeFilter(created_at)\n    GROUP BY 1\n    UNION ALL\n    SELECT date_trunc('day', date_time_utc) AS bucket, 'transactions' AS table_name, COUNT(*)::bigint AS row_count\n    FROM transactions\n    WHERE $__timeFilter(date_time_utc)\n    GROUP BY 1\n    UNION ALL\n    SELECT date_trunc('day', date_time_utc) AS bucket, 'cash_movements' AS table_name, COUNT(*)::bigint AS row_count\n    FROM cash_movements\n    WHERE $__timeFilter(date_time_utc)\n    GROUP BY 1\n    UNION ALL\n    SELECT date_trunc('day', as_of_utc) AS bucket, 'prices' AS table_name, COUNT(*)::bigint AS row_count\n    FROM prices\n    WHERE $__timeFilter(as_of_utc)\n    GROUP BY 1\n    UNION ALL\n    SELECT date_trunc('day', date_utc::timestamp) AS bucket, 'fx_rates' AS table_name, COUNT(*)::bigint AS row_count\n    FROM fx_rates\n    WHERE $__timeFilter(date_utc::timestamp)\n    GROUP BY 1\n    UNION ALL\n    SELECT date_trunc('day', snapshot_at) AS bucket, 'positions_snapshot' AS table_name, COUNT(*)::bigint AS row_count\n    FROM positions_snapshot\n    WHERE $__timeFilter(snapshot_at)\n    GROUP BY 1\n    UNION ALL\n    SELECT date_trunc('day', snapshot_at) AS bucket, 'portfolio_value_snapshot' AS table_name, COUNT(*)::bigint AS row_count\n    FROM portfolio_value_snapshot\n    WHERE $__timeFilter(snapshot_at)\n    GROUP BY 1\n)\nSELECT bucket AS time,\n       table_name AS metric,\n       row_count::double precision AS value\nFROM combined\nORDER BY bucket, table_name;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "pluginVersion": "9.5.0"
    },
