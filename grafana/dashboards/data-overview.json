      "pluginVersion": "9.5.0"
    },
    {
      "id": 10,
      "title": "Gap Count (Last 7 Days)",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "portfolio-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('hour', detected_at) AS time,\n       COUNT(*)::double precision AS value\nFROM data_gaps\nWHERE detected_at >= NOW() - INTERVAL '7 days'\nGROUP BY time\nORDER BY time;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "hidden",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "pluginVersion": "9.5.0"
    },
    {
      "id": 11,
      "title": "Oldest Gap Age (hours)",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "portfolio-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 31
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(EXTRACT(EPOCH FROM (NOW() - MIN(detected_at))) / 3600, 0)::double precision AS hours_old\nFROM data_gaps;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "mappings": [],
          "unit": "hour",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "red",
                "value": 24
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "pluginVersion": "9.5.0"
    }
